JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173,http://localhost:80

AGENT_API_TOKEN=change-me-agent-token
AGENT_USER_EMAIL=pm-agent@bluebolt.local

# MinIO object storage cho avatar. ENDPOINT/ACCESS/SECRET/BUCKET/SECURE dùng
# nội bộ trong mạng docker. PUBLIC_URL là địa chỉ trình duyệt tải ảnh (port 9000
# expose ra host). Đổi mật khẩu trước khi lên prod.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=avatars
MINIO_PUBLIC_URL=http://localhost:9000

GAPO_API_URL=https://api.gapowork.vn/3rd-bot/v1.0/3rd/messages
GAPO_BOT_TOKEN=
GAPO_BOT_ID=
GAPO_SEND_TOKEN=change-me-gapo-send-token
GAPO_DRY_RUN=true
# Bí mật xác thực chữ ký webhook (để trống = tắt xác thực, chỉ dùng cho dev).
# Khi set, mọi webhook phải kèm header HMAC-SHA256 hợp lệ.
GAPO_WEBHOOK_SECRET=
GAPO_SIGNATURE_HEADER=x-gapo-signature

LLM_PROVIDER=9router
NINE_ROUTER_BASE_URL=http://9router:20128/v1
NINE_ROUTER_API_KEY=not-needed
NINE_ROUTER_MODEL=gemini/gemini-3-flash-preview

API_KEY=${NINE_ROUTER_API_KEY}
BASE_URL=${NINE_ROUTER_BASE_URL}
MODEL_NAME=${NINE_ROUTER_MODEL}

# Model riêng cho router phân loại ý định (Flash để nhanh, fail-fast). Tùy chọn.
ROUTER_MODEL_NAME=gemini-2.5-flash

# Credential read-only riêng cho pool DB của agent (xem init/agent_role.sql).
# Nếu để trống, agent fallback dùng DB_USER/DB_PASSWORD (KHÔNG khuyến nghị cho prod).
DB_AGENT_USER=pmbot_ro
DB_AGENT_PASSWORD=change-me-agent-ro-password
# Timeout cứng cho mọi truy vấn của agent (ms) — chống pg_sleep/query nặng.
AGENT_STATEMENT_TIMEOUT_MS=5000
