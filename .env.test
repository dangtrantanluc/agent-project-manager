# Copy this to `.env` and fill in values before `docker compose up`.
# All variables are consumed by /home/bbsw/pm/docker-compose.yaml.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=bbpm
POSTGRES_PASSWORD=bbpm_pwd
POSTGRES_DB=bb_pm
POSTGRES_PORT=5433

# ── bb-pm API ───────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me-super-secret-64-chars-minimum-please-rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# Agent service-user token. Must match BB_PM_AGENT_TOKEN on the openclaw side.
# Generate once: openssl rand -hex 32
AGENT_API_TOKEN=e4def90c2b18bf54dfc4cda8971238795b2e0f15e2c8ef829056f30cbf027d2f
AGENT_USER_EMAIL=pm-agent@bluebolt.local

# MinIO (optional — only needed if you enable avatar upload)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=bb-pm-avatars

# ── bb-pm Web ───────────────────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_BASE=http://localhost:4000/api/v1

# ── OpenClaw ────────────────────────────────────────────────────────────────
OPENCLAW_PORT=18789
# Bearer token for OpenClaw gateway admin surfaces (not the agent flow).
OPENCLAW_GATEWAY_TOKEN=

# ── LLM (self-hosted, OpenAI-compatible) ────────────────────────────────────
# From a container the LLM endpoint is reached via `host.docker.internal`.
# For a tailnet endpoint just use its IP directly.
LLM_BASE_URL=http://100.108.110.17:8000/v1
LLM_API_KEY=nokey
LLM_MODEL=Qwen/Qwen3.6-27B-FP8
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_PROVIDER=9router
NINE_ROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINE_ROUTER_API_KEY=nokey
NINE_ROUTER_MODEL=gemini/gemini-2.5-flash
NINE_ROUTER_MAX_TOKENS=2048
NINE_ROUTER_TEMPERATURE=0.2

# ── Gapo Work bot ───────────────────────────────────────────────────────────
GAPO_API_URL=https://api.gapowork.vn/3rd-bot/v1.0/3rd/messages
GAPO_BOT_TOKEN=ea2c521de17646b7abec15044be345c0
GAPO_BOT_ID=5858751553606783229
# Set true only for local smoke tests; outbound payloads are built but not sent.
GAPO_DRY_RUN=false
# Shared secret between openclaw plugins (bb-pm-tools -> gapo-agent /send).
# Generate once: openssl rand -hex 32
GAPO_SEND_TOKEN=f2ccf92fd086de5b0fe9c85377aa40f69a4d03d01c86ce0cfe79a02c597c7a93

# ── Cron ───────────────────────────────────────────────────────────────────
CRON_TZ=Asia/Ho_Chi_Minh
CRON_DAILY_DIGEST=0 8 * * *
CRON_DAILY_DIGEST_TARGET=
CRON_WEEKLY_HYGIENE=0 9 * * MON
CRON_WEEKLY_HYGIENE_TARGET=
# Keep reminder cron disabled for first deploy; enable only after bot smoke tests.
CRON_CHECKIN_ENABLED=false
CRON_NOON_CHECKIN=50 11 * * 1-5
CRON_EOD_CHECKIN=50 17 * * 1-5
CRON_MISSING_CHECKIN_FOLLOWUP=0 18 * * 1-5
